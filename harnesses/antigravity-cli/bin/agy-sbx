#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"

while [[ -L "$SOURCE" ]]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done

SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
TEMPLATE="agy-sbx:local"
KIT="$ROOT/harnesses/antigravity-cli/kit"
BOOTSTRAP="$ROOT/harnesses/antigravity-cli/scripts/bootstrap.sh"
VERIFY="$ROOT/harnesses/antigravity-cli/scripts/verify.sh"
BOOTSTRAP_MARKER="/home/agent/.cache/claude-sbx/antigravity-bootstrap-v1"

SANDBOX_PREFIX="agy"
SANDBOX_AGENT="shell"
# shellcheck source=shared/launcher.sh
source "$ROOT/shared/launcher.sh"

run_agent() {
  local name="$1"
  shift
  exec sbx exec -it "$name" agy "$@"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
