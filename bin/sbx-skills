#!/usr/bin/env bash
set -euo pipefail

if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
  return 0
fi
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." >/dev/null 2>&1 && pwd)"
# shellcheck source=shared/skills.sh
source "$ROOT/shared/skills.sh"
if [[ $# -gt 1 || ($# == 1 && "$1" != --update) ]]; then
  echo 'Usage: sbx-skills [--update]' >&2
  exit 2
fi
ensure_shared_skills "$(shared_skills_store)" "${1:-}"
sbx skills ls
