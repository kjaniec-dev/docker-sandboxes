#!/usr/bin/env bash
set -euo pipefail

resolve_self() {
  local source="${BASH_SOURCE[0]}" dir
  while [[ -L "$source" ]]; do
    dir="$(cd -P "$(dirname "$source")" >/dev/null 2>&1 && pwd)"
    source="$(readlink "$source")"
    [[ "$source" != /* ]] && source="$dir/$source"
  done
  printf '%s\n' "$source"
}

SELF="$(resolve_self)"
ROOT="$(cd -P "$(dirname "$SELF")/.." >/dev/null 2>&1 && pwd)"

usage() {
  cat >&2 <<'EOF'
usage:
  sbx-dev <claude|codex|opencode|antigravity|junie|copilot> [agent args...]
  claude-sbx [agent args...]
  codex-sbx [agent args...]
  opencode-sbx [agent args...]
  agy-sbx [agent args...]
  junie-sbx [agent args...]
  copilot-sbx [agent args...]

profile:
  SBX_PROFILE=personal   # default
  SBX_PROFILE=client
EOF
}

command_name="$(basename "$0")"
case "$command_name" in
  claude-sbx) agent=claude ;;
  codex-sbx) agent=codex ;;
  opencode-sbx) agent=opencode ;;
  agy-sbx) agent=antigravity ;;
  junie-sbx) agent=junie ;;
  copilot-sbx) agent=copilot ;;
  sbx-dev)
    [[ $# -gt 0 ]] || { usage; exit 2; }
    agent="$1"
    shift
    ;;
  *)
    echo "sbx-dev: unknown invocation name: $command_name" >&2
    exit 2
    ;;
esac

config_root="${XDG_CONFIG_HOME:-$HOME/.config}/docker-sandboxes"
profile="${SBX_PROFILE:-}"
if [[ -z "$profile" && -f "$config_root/profile" ]]; then
  profile="$(tr -d '[:space:]' < "$config_root/profile")"
fi
profile="${profile:-personal}"

case "$profile:$agent" in
  personal:claude|personal:codex|personal:opencode|personal:antigravity|personal:junie) ;;
  client:claude|client:copilot) ;;
  *)
    echo "sbx-dev: agent '$agent' is not enabled in profile '$profile'" >&2
    exit 2
    ;;
esac

git_audit_policy=--allow-integrations
case "${SBX_GIT_AUDIT:-compatible}" in
  compatible) ;;
  strict) git_audit_policy=--strict ;;
  *) echo "sbx-dev: SBX_GIT_AUDIT must be compatible or strict" >&2; exit 2 ;;
esac

command -v sbx >/dev/null 2>&1 || {
  echo "sbx-dev: 'sbx' not found; install Docker Sandboxes 0.50.0+" >&2
  exit 1
}

sbx version --json | python3 "$ROOT/bin/check-sbx-version.py"
export SBX_KIT_BUILDER="${SBX_KIT_BUILDER-sandbox}"

repo_metadata="$(python3 "$ROOT/bin/audit-git.py" "$git_audit_policy" --discover-identity)"
{
  IFS= read -r -d '' repo_root
  IFS= read -r -d '' repo_metadata_identity
} < <(python3 -c 'import json,sys; root,identity=json.loads(sys.argv[1]); sys.stdout.write(root+"\0"+identity+"\0")' "$repo_metadata")
# Keep this shell alive so failed provisioning, agent exits and catchable signals
# all pass through the same post-session check. This detects unsafe metadata;
# writable .git remains shared with the host (see docs/git-metadata.md).
name=""
session_started=false
audit_on_exit() {
  local status=$? audit_status=0 quarantined
  trap - EXIT
  python3 "$ROOT/bin/audit-git.py" "$git_audit_policy" "$repo_root" "$repo_metadata_identity" || audit_status=$?
  if [[ "$audit_status" != 0 && "$session_started" == true ]]; then
    # A Git-aware prompt would run planted commands before the warning is read:
    # stop the sandbox and move audited repositories' .git aside.
    [[ -z "$name" ]] || sbx stop "$name" >/dev/null 2>&1 || true
    quarantined="$(python3 "$ROOT/bin/audit-git.py" "$git_audit_policy" --quarantine "$repo_root")" || true
    if [[ -n "$quarantined" ]]; then
      printf 'sbx-dev: Git metadata moved to:\n%s\nInspect it with trusted tools, then mv each entry back to .git\n' "$quarantined" >&2
    fi
  fi
  [[ "$status" != 0 ]] || status=$audit_status
  exit "$status"
}
trap audit_on_exit EXIT
sbx_pid=
wait_interrupted=false
forward_signal() {
  if [[ -n "$sbx_pid" ]]; then
    wait_interrupted=true
    kill -s "$1" "$sbx_pid" 2>/dev/null || true
  else
    exit "$2"
  fi
}
trap 'forward_signal INT 130' INT
trap 'forward_signal TERM 143' TERM

run_sbx() {
  local status=0
  # Bash can process traps while waiting for an asynchronous child. Explicitly
  # preserve stdin and restore the INT disposition Bash gives background jobs.
  python3 "$ROOT/bin/exec-sbx.py" "$@" <&0 &
  sbx_pid=$!
  while :; do
    wait_interrupted=false
    wait "$sbx_pid" && status=0 || status=$?
    [[ "$wait_interrupted" == true ]] || break
  done
  sbx_pid=
  return "$status"
}

if [[ -L "$repo_root/.worktrees" || -n "$(git -c core.fsmonitor=false -c core.hooksPath=/dev/null -C "$repo_root" ls-files -- .worktrees)" ]]; then
  echo "sbx-dev: .worktrees/ must be an untracked directory inside the repository" >&2
  exit 3
fi
if ! git -c core.fsmonitor=false -c core.hooksPath=/dev/null -C "$repo_root" check-ignore -q "$repo_root/.worktrees/.sbx-ignore-probe"; then
  echo "sbx-dev: .worktrees/ must be ignored by Git before launching" >&2
  exit 3
fi
mkdir -p "$repo_root/.worktrees"

slug="$(basename "$repo_root" | tr '[:upper:]_' '[:lower:]-' | sed -E 's/[^a-z0-9.-]+/-/g; s/^-+//; s/-+$//')"
slug="${slug:-project}"
digest="$(printf '%s' "$repo_root" | shasum -a 256 | awk '{print substr($1,1,8)}')"
prefix="$agent"
[[ "$profile" == client ]] && prefix="client-$agent"
name="$prefix-$slug-$digest"

agent_env="$ROOT/env/$profile/$agent.sbxenv.yaml"
common_env="$ROOT/env/common.sbxenv.yaml"
[[ -f "$agent_env" ]] || { echo "sbx-dev: missing environment: $agent_env" >&2; exit 2; }

files=("$agent_env" "$common_env")
local_overlay="$config_root/$profile.sbxenv.yaml"
[[ -f "$local_overlay" ]] && files+=("$local_overlay")

args=(--env-arg "workspace=$repo_root")
if [[ "$profile:$agent" == client:claude ]]; then
  # Not ${VAR:?}: Bash 3.2 reports status 0 to the EXIT trap after that expansion fails.
  [[ -n "${ANTHROPIC_VERTEX_PROJECT_ID:-}" ]] || { echo "sbx-dev: Set ANTHROPIC_VERTEX_PROJECT_ID for client Claude Vertex" >&2; exit 2; }
  [[ -n "${CLOUD_ML_REGION:-}" ]] || { echo "sbx-dev: Set CLOUD_ML_REGION for client Claude Vertex" >&2; exit 2; }
  args+=(
    --env-arg "vertexProject=$ANTHROPIC_VERTEX_PROJECT_ID"
    --env-arg "vertexRegion=$CLOUD_ML_REGION"
  )
fi

session_started=true
# Apply/reconcile the declarative environment without opening an agent session.
run_sbx env run "${files[@]}" --name "$name" --detach "${args[@]}"

if [[ "$agent" == junie ]]; then
  brave=true
  for argument in "$@"; do
    case "$argument" in --brave|--brave=*|--no-brave) brave=false ;; esac
  done
  [[ "$brave" != true ]] || set -- --brave "$@"
  # The official kit masks a custom secret with proxy-managed. Override only
  # its public placeholder; native env exec also applies updated JVM settings.
  placeholder="$(python3 "$ROOT/workloads/junie-dev/token-placeholder.py" "$name")"
  exec_args=(env exec --name "$name" "${args[@]}" --env "JUNIE_API_KEY=$placeholder")
  [[ ! -t 0 || ! -t 1 ]] || exec_args+=(-it)
  run_sbx "${exec_args[@]}" "${files[@]}" -- junie "$@"
elif [[ "$profile:$agent" == client:claude ]]; then
  placeholder="$(python3 "$ROOT/workloads/claude-dev/token-placeholder.py" "$name" "$CLOUD_ML_REGION")"
  exec_args=(env exec --name "$name" "${args[@]}" --env "ANTHROPIC_AUTH_TOKEN=$placeholder")
  [[ ! -t 0 || ! -t 1 ]] || exec_args+=(-it)
  run_sbx "${exec_args[@]}" "${files[@]}" -- claude --dangerously-skip-permissions "$@"
else
  run_args=(run --name "$name")
  if (($# > 0)); then
    run_sbx "${run_args[@]}" -- "$@"
  else
    run_sbx "${run_args[@]}"
  fi
fi
